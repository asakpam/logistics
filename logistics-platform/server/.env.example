PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
# SUPABASE_URL: Your project URL (e.g., https://xxxxx.supabase.co)
# SUPABASE_SERVICE_KEY: Service role key (keep secret! has full database access)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
# Save the JSON file as server/serviceAccountKey.json  (already in .gitignore)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Alternatively paste the entire JSON as a single escaped line (leave blank when using the file path above)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Twilio SMS ───────────────────────────────────────────────────────────────
# Sign up at https://www.twilio.com — free trial gives ~$15 credit
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ─── FCM Push Notifications ───────────────────────────────────────────────────
# Firebase Console → Project Settings → Cloud Messaging → Server key
FCM_SERVER_KEY=AAAAxxxxxxxx:APA91bxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Maps (optional — Leaflet uses OpenStreetMap by default) ───────────
# Only needed if you swap the tile layer to Google Maps tiles
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
