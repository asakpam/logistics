PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-app.vercel.app

# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
# SUPABASE_URL: Your project URL (e.g., https://ekkeajtpxgwrtcebumhh.supabase.co)
# SUPABASE_SERVICE_KEY: Service role key (secret key with full server-side database access)
SUPABASE_URL=https://ekkeajtpxgwrtcebumhh.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ─── Twilio SMS (Optional - enables auto-SMS on dispatch/delivery) ─────────────
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
